{
  "schemaVersion": 1,
  "id": "iustitia",
  "version": "${version}",
  "name": "Iustitia",
  "description": "Client-sided anticheat/inspector. Detects impossible world/combat interactions from other players by parsing incoming server packets. Local-only chat alerts.",
  "icon": "iustitia.png",
  "authors": ["ThoriaDevelopment"],
  "contact": {
    "homepage": "https://thoria.fyi/iustitia",
    "sources": "https://github.com/ThoriaDevelopment/Iustitia"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [ "dev.iustitia.IustitiaClientMod" ]
  },
  "mixins": [
    "iustitia.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "yet_another_config_lib_v3": "*"
  },
  "recommends": {
    "viafabricplus": "*"
  }
}